# Receiver Bluetooth DIY — configurações padrão do menuconfig (ESP-IDF)
# Aplicadas na primeira geração do sdkconfig. Ajustes manuais via
# `pio run -t menuconfig` sobrescrevem o sdkconfig, não este arquivo.

# --- Bluetooth ---
# AVRCP não tem uma opção própria nesta versão do IDF: fica acoplado ao
# A2DP (BT_AVRCP_ENABLED é "selecionado" automaticamente por BT_A2DP_ENABLE).
# O papel (Controller/Target) é escolhido em código, via esp_avrc_ct_init().
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_SPP_ENABLED=n

# O controlador Bluetooth (radio) tem 3 modos: BLE Only, BR/EDR Only ou Dual
# Mode. Sem essa escolha explícita, o Kconfig cai no primeiro item da lista
# (BLE Only) por padrão — o que quebraria o A2DP/AVRCP (Bluetooth Classic),
# já que o projeto não usa BLE em nenhum lugar. Fixar em BR/EDR Only também
# libera bastante IRAM (stack BLE inteira fica de fora do build).
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BT_BLE_ENABLED=n

# --- Bootloader ---
# O bootloader.bin (29312 bytes) passa dos 28KB reservados entre 0x1000 e o
# offset padrão da tabela de partições (0x8000), colidindo com ela
# ("Detected overlap at address: 0x8000"). Baixar o log não resolveu (WARN
# e NONE dão o mesmo tamanho — as poucas mensagens do bootloader já eram
# INFO). Solução oficial do ESP-IDF: mover a tabela de partições pra depois
# (ver partitions.csv, NVS encolhido de 20KB pra 16KB pra compensar).
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_PARTITION_TABLE_OFFSET=0x9000

# --- Partições ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- Memória ---
# Confirmado por log: essa placa TEM PSRAM (8MB, "esp_psram: Found 8MB
# PSRAM device", ~4MB mapeados/usáveis — limite do próprio chip ESP32
# clássico). Isso muda o heap livre de ~11-26KB pra ~4MB. Sem PSRAM real,
# SPIRAM_IGNORE_NOTFOUND evita panic no boot (só desativa e segue sem ela).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
# Wi-Fi/LWIP alocam da PSRAM em vez de brigar com o Bluetooth pela DRAM
# interna — era exatamente a causa dos crashes por heap fragmentado/exaurido
# durante o A2DP com MQTT ativo, antes de descobrirmos a PSRAM.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# NAO habilitar CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY: chegamos a ligar
# essa opcao achando que moveria o stack da task do decoder FLAC (slim_data,
# main/slimproto.c) pra PSRAM, poupando RAM interna. Confirmado via
# documentacao oficial da Espressif (guia de RAM externa) que xTaskCreate()
# -- a funcao dinamica que usamos -- SEMPRE aloca o stack da RAM interna,
# nao importa esse Kconfig; so xTaskCreateStatic() com buffer alocado
# manualmente em PSRAM consegue isso de verdade. E pior: fazer isso de
# verdade seria a direcao ERRADA pra uma task que chama codigo de rede/ROM
# (sockets lwIP) -- o cache que da acesso a PSRAM fica desligado durante
# qualquer escrita de flash/NVS por QUALQUER task do sistema, entao um stack
# de execucao em PSRAM pode "crashar" (excecao de acesso a cache invalido)
# bem no meio de uma chamada, de forma intermitente e dificil de reproduzir.
# Confirmado tambem no codigo-fonte do squeezelite-esp32 (sle118, referencia
# ja usada neste projeto pra pinagem): a task de decode deles usa 16KB de
# RAM interna (embedded.h, DECODE_THREAD_STACK_SIZE), nunca PSRAM -- PSRAM
# la (como aqui) e so pra BUFFERS DE DADOS, nunca pro stack de uma task.

# Sem essas duas, IRAM estoura com BT (Bluedroid) + Wi-Fi + mDNS juntos.
# Custo: leve aumento no consumo de energia em modo power-save do Wi-Fi
# (irrelevante aqui, o dispositivo é alimentado via fonte externa).
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n

# --- MQTT ---
# Usamos só "mqtt://" (broker local do Home Assistant, sem TLS) e nunca
# websocket. Desativar os dois libera espaço de flash significativo,
# apertado nesta placa (ver Notas no README).
CONFIG_MQTT_TRANSPORT_SSL=n
CONFIG_MQTT_TRANSPORT_WEBSOCKET=n

# --- mbedTLS ---
# Nada no firmware faz handshake TLS (MQTT é mqtt:// puro, o web server é
# HTTP puro, e o OTA — Etapa 10 — recebe o .bin via upload multipart no
# nosso próprio servidor, não busca de uma URL HTTPS externa). O mbedtls
# continua linkado (tcp_transport/esp-tls exigem em tempo de compilação, e
# libmbedcrypto é usado pelo pareamento Secure Simple Pairing do
# Bluetooth), mas o bundle de certificados raiz e o papel de servidor TLS
# não têm nenhum uso e só ocupam flash à toa.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
CONFIG_MBEDTLS_TLS_SERVER=n

# --- FreeRTOS ---
CONFIG_FREERTOS_HZ=1000

# --- Task "main" (app_main, loop principal) ---
# Confirmado ao vivo (2026-08-14, captura serial): "***ERROR*** A stack
# overflow in task main has been detected" -- duas vezes seguidas, poucos
# segundos depois do boot, assim que MQTT/Slimproto/AGC/watchdog de rede
# comecaram a rodar juntos de verdade (mqtt_ha_publish_state() e
# network_watchdog_check(), chamados a cada 30s no loop de main.c, tem
# varios buffers locais e chamadas aninhadas -- nunca auditados de perto
# porque toda a investigacao de stack de hoje mirou a task slim_data do
# decoder FLAC, nao a task main). O padrao (default do ESP-IDF) e so 3584
# bytes -- pequeno demais pro que essa task faz hoje em dia. Task unica e
# permanente (nao por-faixa), entao aumentar aqui e igual ao raciocinio ja
# usado pro stack estatico do slim_data: seguro, sem fragmentacao.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# --- CPU ---
# Confirmado ao vivo (2026-08-14) que a decodificacao FLAC + rede nao
# sustentam o ritmo real de audio: o nivel do ring buffer (log de diagnostico
# temporario) caiu de forma CONTINUA e SUSTENTADA (79KB -> 0KB em ~5-9s, todo
# ciclo, nao um soluco isolado) durante reproducao normal. O boot log mostrava
# "cpu freq: 160000000 Hz" -- 160MHz, nao os 240MHz maximos do ESP32 -- sem
# nenhuma decisao documentada pra isso (nao aparecia em lugar nenhum deste
# arquivo antes, provavelmente so o default que sobrou da config do board).
# Decodificar FLAC e trabalho pesado de CPU; 160MHz tira ~33% do poder de
# processamento disponivel comparado ao maximo. Aumentar pra 240MHz custa so
# mais energia (irrelevante aqui, fonte externa) e mais um pouco de calor --
# sem downside conhecido pro nosso caso de uso.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_ESP32_DEFAULT_CPU_FREQ_240=y

# --- Flash ---
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# --- SPIFFS ---
CONFIG_SPIFFS_USE_MAGIC_LENGTH=y

# --- LWIP ---
# Padrao e 10 sockets pro sistema INTEIRO. Com dois servidores HTTP
# completos rodando ao mesmo tempo (web_server.c na porta 80 + o
# dlna_renderer.c na porta 8200) mais mDNS, MQTT e o socket UDP do SSDP,
# 10 estoura fácil (visto em log: "httpd_accept_conn: error in accept
# (23)" = ENFILE, sem socket livre pra aceitar conexao nova) assim que
# algum control point DLNA abre varias conexoes seguidas buscando os XMLs
# de descricao/SCPD. Subido de 10 pra 16 nessa mesma investigacao -- e
# ainda ESTOUROU de novo (mesmo erro, ao vivo) depois que o Pause/Play
# real do DLNA passou a MANTER a conexao HTTP de busca aberta durante uma
# pausa (antes, pausar fechava a conexao na hora, liberando o socket; agora
# fica reservado por todo o tempo pausado). 16 ainda nao e suficiente sob
# uma rajada de comandos do MA (Stop/SetAVTransportURI/Play repetidos) --
# subindo pra 24 (custo de RAM irrisorio, ~200-400 bytes por socket extra,
# sobra de PSRAM de sobra neste projeto).
CONFIG_LWIP_MAX_SOCKETS=24
