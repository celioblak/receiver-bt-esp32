# Receiver Bluetooth DIY — configurações padrão do menuconfig (ESP-IDF)
# Aplicadas na primeira geração do sdkconfig. Ajustes manuais via
# `pio run -t menuconfig` sobrescrevem o sdkconfig, não este arquivo.

# --- Bluetooth ---
# AVRCP não tem uma opção própria nesta versão do IDF: fica acoplado ao
# A2DP (BT_AVRCP_ENABLED é "selecionado" automaticamente por BT_A2DP_ENABLE).
# O papel (Controller/Target) é escolhido em código, via esp_avrc_ct_init().
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_SPP_ENABLED=n

# O controlador Bluetooth (radio) tem 3 modos: BLE Only, BR/EDR Only ou Dual
# Mode. Sem essa escolha explícita, o Kconfig cai no primeiro item da lista
# (BLE Only) por padrão — o que quebraria o A2DP/AVRCP (Bluetooth Classic),
# já que o projeto não usa BLE em nenhum lugar. Fixar em BR/EDR Only também
# libera bastante IRAM (stack BLE inteira fica de fora do build).
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BT_BLE_ENABLED=n

# --- Bootloader ---
# O bootloader.bin (29312 bytes) passa dos 28KB reservados entre 0x1000 e o
# offset padrão da tabela de partições (0x8000), colidindo com ela
# ("Detected overlap at address: 0x8000"). Baixar o log não resolveu (WARN
# e NONE dão o mesmo tamanho — as poucas mensagens do bootloader já eram
# INFO). Solução oficial do ESP-IDF: mover a tabela de partições pra depois
# (ver partitions.csv, NVS encolhido de 20KB pra 16KB pra compensar).
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_PARTITION_TABLE_OFFSET=0x9000

# --- Partições ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- Memória ---
# Confirmado por log: essa placa TEM PSRAM (8MB, "esp_psram: Found 8MB
# PSRAM device", ~4MB mapeados/usáveis — limite do próprio chip ESP32
# clássico). Isso muda o heap livre de ~11-26KB pra ~4MB. Sem PSRAM real,
# SPIRAM_IGNORE_NOTFOUND evita panic no boot (só desativa e segue sem ela).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
# Wi-Fi/LWIP alocam da PSRAM em vez de brigar com o Bluetooth pela DRAM
# interna — era exatamente a causa dos crashes por heap fragmentado/exaurido
# durante o A2DP com MQTT ativo, antes de descobrirmos a PSRAM.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Sem essas duas, IRAM estoura com BT (Bluedroid) + Wi-Fi + mDNS juntos.
# Custo: leve aumento no consumo de energia em modo power-save do Wi-Fi
# (irrelevante aqui, o dispositivo é alimentado via fonte externa).
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n

# --- MQTT ---
# Usamos só "mqtt://" (broker local do Home Assistant, sem TLS) e nunca
# websocket. Desativar os dois libera espaço de flash significativo,
# apertado nesta placa (ver Notas no README).
CONFIG_MQTT_TRANSPORT_SSL=n
CONFIG_MQTT_TRANSPORT_WEBSOCKET=n

# --- mbedTLS ---
# Nada no firmware faz handshake TLS (MQTT é mqtt:// puro, o web server é
# HTTP puro, e o OTA — Etapa 10 — recebe o .bin via upload multipart no
# nosso próprio servidor, não busca de uma URL HTTPS externa). O mbedtls
# continua linkado (tcp_transport/esp-tls exigem em tempo de compilação, e
# libmbedcrypto é usado pelo pareamento Secure Simple Pairing do
# Bluetooth), mas o bundle de certificados raiz e o papel de servidor TLS
# não têm nenhum uso e só ocupam flash à toa.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
CONFIG_MBEDTLS_TLS_SERVER=n

# --- FreeRTOS ---
CONFIG_FREERTOS_HZ=1000

# --- Flash ---
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# --- SPIFFS ---
CONFIG_SPIFFS_USE_MAGIC_LENGTH=y
